# Публикуемые исходники и документы всех глав.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/main.py
!/chapter1/
!/chapter2/
!/chapter3/
!/common/
!/data/
!/templates/
!/static/

# Из данных включаем только используемый набор и описание источника.
/data/*
!/data/README.md
!/data/m5_sales.csv

# Рабочая база создаётся локально из CSV; пользовательские расчёты не публикуются.
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# План-задание никогда не публикуем, включая его копии в других папках.
